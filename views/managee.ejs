<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="author" content="Kondwani Phiri">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Employee</title>
    <link rel="stylesheet" href="stylesheets/viewe.css">
    <link rel="stylesheet" href="stylesheets/managee.css">
    <script src="javascripts/jquery-3.6.0.min.js"></script>
    <script src="/javascripts/common.js"></script>

<link rel="stylesheet" href="/stylesheets/improvements.css">
</head>
<body>
<header class="page-toolbar"><a href="/home">Dashboard</a><span>Staff assignments</span><a href="/appointments">Assignments</a></header>

<section>
<div class="section0">
    <input type="text" placeholder="Search" id="search">
    <div class="radio">
        <input checked name="search" value="id" type="radio" id="id">
        <label for="id"> ID</label>
        <input name="search" value="name" type="radio" id="name">
        <label for="name"> Name</label>
        <input name="search" value="SSN" type="radio" id="SSN">
        <label for="SSN"> SSN</label>
    </div>
</div>
<div class="section1">
<table class="contentTable">
    <thead>
    <tr>
       <th> ID </th>
       <th> First Name </th>
        <th>Surname</th>
        <th>Postion</th>
        <th>Street</th>
        <th>Town</th>
        <th>Province</th>
        <th>NRC</th>
    </tr>
</thead>
    <tbody id="viewe">
    </tbody>
</table>
</div>

<div class="doctor">
    <h1>Assign Doctor To Patient</h1>
    <div class="img"></div>
    <div class="details">
        <h3>ID</h3><span class="lId">-</span>
        <div><h3>Position</h3><span class="lPosition">-</span>
             <h3>First Name</h3> <span class="lFirstName">-</span>
             <h3>Surname</h3><span class="lSurname">-</span>
        </div>
    </div>
    <div class="doctor-patient">
        <h2>Assign to Patient</h2>
            <h1 id="h1Id">ID</h1>
            <input type="text" required name="" id="searchId">
            <br><span>Name: </span><span class="patientFirstName">-</span><span class="patientSurname">-</span>
            <br><button class="doctorPatientAssign">Assign</button>
    </div>
    <div class="nurse-ward">
        <h2>Assign to Ward</h2>
            <span>Ward Id: </span><span class="wardIdSelect">-</span><br><br>
            <span>Ward Name:</span>
            <select class="wardNameSelect" name="" id="">
                <option value="Ward A">Ward A</option>
            </select>
            <br><button class="nurseWardAssign">Assign</button>

    </div>
</div>
    

</section>

<script src="javascripts/managee.js"></script>
</body>
</html>