<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="author" content="Kondwani Phiri">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Management System</title>
    <link rel="stylesheet" href="stylesheets/style.css">
    <script src="javascripts/jquery-3.6.0.min.js"></script>
    <script src="/javascripts/common.js"></script>
<link rel="stylesheet" href="/stylesheets/improvements.css">
</head>
<body>
  <h1 class="welcome">
    Hospital Management System
  </h1>
  <button class="login">Login</button>
<h1 class="close">X</h1>
<div class="wrapper">
  <form action="">
    <h1>Welcome</h1>
    <input type="text" class="userName" name="userName" placeholder="Username">
    <input type="password" class="password" name="password" placeholder="password">
    <span class="message"></span>
    <input type="submit" value="Login" name="" class="submit">
  </form>
</div>


<script>
$('.close').hide();
$('.wrapper').hide();
$('.message').hide();
$('button').click(function(){
  $('button').hide();
  $('.wrapper').slideDown(200);
  $('.close').slideDown(200);
  $('.welcome').hide();

})
$('.close').click(function(){
  $('.wrapper').hide();
  $('.close').hide();
  $('button').slideDown(200);
  $('.welcome').slideDown(200);
})

$('.password, .userName').keydown(function(){
  $('.message').hide();
})


$('form').submit(function(event){
 event.preventDefault();
 $('.submit').prop('disabled',true);
 $.ajax({url:'/database/action',method:'POST',dataType:'json',
 data:{action:'login',username:$('.userName').val(),password:$('.password').val()},
 success:function(){location.href='/home';},
 complete:function(){$('.submit').prop('disabled',false);}});
});
</script></body></html>
