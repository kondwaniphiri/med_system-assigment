<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="author" content="Kondwani Phiri">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Patient</title>
    <link rel="stylesheet" href="stylesheets/addp.css">
    <script src="javascripts/jquery-3.6.0.min.js"></script>
    <script src="/javascripts/common.js"></script>
<link rel="stylesheet" href="/stylesheets/improvements.css">
</head>
<body>
<header class="page-toolbar"><a href="/home">Dashboard</a><span>Add or edit patient</span><a href="/appointments">Assignments</a></header>

    <div id="addPatientTable" >
        <div class="input">
        <h2>Add Patient</h1>
        <h1 id="h1Id">ID</h1>
        <input aria-label="search Id" maxlength="10" type="text" name="" id="searchId" onkeydown="focusNext(event,'firstName','searchId')">
        <h1>First Name</h1>
        <input aria-label="first Name" maxlength="50" type="text" name="" required id="firstName" onkeydown="focusNext(event,'surname','searchId')">
        <h1>Surname</h1>
        <input aria-label="surname" maxlength="50" type="text" name="" required id="surname" onkeydown="focusNext(event,'insurance','firstName')">
        <h1>Insurance Company Name</h1>
        <input aria-label="insurance" maxlength="100" type="text" name="" id="insurance"  onkeydown="focusNext(event,'phone','surname')">
        <h1>Phone Number</h1>
        <input aria-label="phone" maxlength="20" type="tel" name="" id="phone" onkeydown="focusNext(event,'street','insurance')">
        <h1>Street</h1>
        <input aria-label="street" maxlength="100" type="text" name="" id="street" onkeydown="focusNext(event,'town','phone')">
        <h1>Town</h1>
        <input aria-label="town" maxlength="50" type="text" name="" id="town" onkeydown="focusNext(event,'province','street')">
        <h1>Province</h1>
        <input aria-label="province" maxlength="50" type="text" name="" id="province" onkeydown="focusNext(event,'province','town')">
        </div>
<div class="buttons">
    <button onclick="addPatient()" id="addSubmit">Add</button>
    <div><input type="checkbox" id="enable"><label for="enable">Enable Update & Delete</label></div>
    <button onclick="updatePatient()">Update</button>
    <button onclick="deletePatient()">Delete</button>
    <button class="clear">Clear</button>
    
</div>
<div>


    <script src="/javascripts/record-form.js"></script>
<script src="javascripts/addp.js"></script>
</body>
</html>