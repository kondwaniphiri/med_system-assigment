<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Employee</title>
    <link rel="stylesheet" href="stylesheets/viewe.css">
    <script src="javascripts/jquery-3.6.0.min.js"></script>
</head>
<body>



<section>
<div class="section0">
    <input type="text" placeholder="Search" id="search">
    <div class="radio">
        <input checked name="search" value="id" type="radio" id="id">
        <label for="id"> ID</label>
        <input name="search" value="name" type="radio" id="name">
        <label for="name"> Name</label>
        <input name="search" value="SSN" type="radio" id="SSN">
        <label for="SSN"> SSN</label>
    </div>
</div>
<div class="section1">
<table class="contentTable">
    <thead>
    <tr>
       <th> ID </th>
       <th> First Name </th>
        <th>Surname</th>
        <th>Postion</th>
        <th>Street</th>
        <th>Town</th>
        <th>Province</th>
        <th>SSN</th>
    </tr>
</thead>
    <tbody id="viewe">
    </tbody>
</table>

</div>
<div class="section2">
<h1>Employee Details</h1>
<div class="img"></div>
<div class="details">
    <h3>ID</h3><span class="lId">-</span>
    <h3>First Name</h3> <span class="lFirstName">-</span>
    <h3>Surname</h3><span class="lSurname">-</span>
    <h3>Position</h3><span class="lPosition">-</span>
    <h3>Street</h3> <span class="lStreet">-</span>
    <h3>Town</h3> <span class="lTown">-</span>
    <h3>Province</h3> <span class="lProvince">-</span>
    <h3>SSN</h3> <span class="lSSN">-</span>
    
</div>
</div>
</section>


<script src="javascripts/viewe.js"></script>
</body>
</html>