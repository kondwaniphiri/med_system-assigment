PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hospital
DB_CONNECTION_LIMIT=10
# Generate a random secret of at least 32 characters before production use.
SESSION_SECRET=
SESSION_MAX_AGE=3600000
# Set to 1 only when running behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0
# Optional: initial admin password (12+ characters). Otherwise setup generates one.
ADMIN_PASSWORD=

# Optional password for a new demo.doctor account created with --sample.
DOCTOR_PASSWORD=
